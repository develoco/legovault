toximaxi.duckdns.org:4443 {
    tls {
        dns duckdns {env.DUCKDNS_TOKEN}
    }

    # Vaultwarden runs on 8080 by default inside its container. 
    # Since we are using network_mode: host, use 127.0.0.1:8080 (or the VW port)
    reverse_proxy 127.0.0.1:8080
    
    log {
        output file {env.LOG_FILE}
    }
}
